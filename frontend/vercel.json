{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://raajwarasa-api.onrender.com/api/$1" },
    { "source": "/uploads/(.*)", "destination": "https://raajwarasa-api.onrender.com/uploads/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "$schema": "https://openapi.vercel.sh/vercel.json"
}