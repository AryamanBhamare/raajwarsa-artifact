# Copy this file to `.env` and replace every placeholder.
# The Docker Compose stack reads this file automatically.

# --- Database (PostgreSQL) ---
POSTGRES_DB=raajwarasa
DATABASE_USER=postgres
DATABASE_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5433

# --- API (Spring Boot) ---
API_PORT=8080
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MS=604800000
# Change both the first time you log in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
UPLOAD_DIR=./uploads
# Comma-separated origins allowed to call the API directly from the browser.
# With the nginx proxy you can normally leave this at the site origin.
CORS_ORIGINS=http://localhost

# --- Web (nginx) ---
WEB_PORT=80

# --- Integration tests (CI/dev) ---
# A dedicated throwaway database; create it before running `mvn test`.
TEST_DB_URL=jdbc:postgresql://localhost:5433/raajwarasa_test
TEST_DB_USER=postgres
TEST_DB_PASSWORD=replace-with-the-same-password-as-above